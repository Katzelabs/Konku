# Copy to .env for local development.

# Dev compose exposes Postgres on 5433 to avoid colliding with a local install.
#
# Two principals, exactly as in production (D-059) — and this file is the one
# that has to say so, because a value in .env beats the Makefile's default.
#
# This was postgres://konku:... until 2026-08-14. `konku` is the image's
# bootstrap superuser: it is rolsuper AND rolbypassrls, and FORCE ROW LEVEL
# SECURITY applies to neither. Every policy in migration 00006 was therefore
# inert in the one environment that holds real data (D-067), and CI was the
# only place RLS actually ran — so a scoping bug would surface on a CI run
# three commits later rather than while you were using the app.
#
# Run `make db-app-role` once after `make db-up` to give konku_app its password.
DATABASE_URL=postgres://konku_app:konku_app_dev@localhost:5433/konku?sslmode=disable

# The owner, used once at startup for migrations and then closed. konku_app has
# no DDL rights at all, so without this the schema cannot be created.
MIGRATION_DATABASE_URL=postgres://konku:konku@localhost:5433/konku?sslmode=disable

PORT=8080

# Relaxes cookie Secure so http://localhost works. Never set in production.
DEV=true

# Required outside dev. Generate with: openssl rand -base64 32
SESSION_SECRET=

SESSION_TTL_DAYS=30

# Error tracking (06 P3). Empty disables it, which is the normal case in dev
# and in tests. A dev DSN is enough to verify delivery — Sentry does not care
# that the process is on a laptop.
SENTRY_DSN=
# Tags every event, so a regression points at a deploy rather than at a date.
# CI sets this to the release tag; locally "dev" is fine.
SENTRY_RELEASE=dev
SENTRY_ENVIRONMENT=development

# /metrics, on its own listener — a separate socket cannot be exposed by a Caddy
# misconfiguration the way a route on the main mux can (D-062). Empty disables
# it.
#
# Loopback is right *here*, because dev runs the process on your machine. It is
# wrong in a container, where the namespace means 127.0.0.1 is the container's
# own loopback and nothing outside can reach it. Production sets 0.0.0.0 and
# publishes no port instead; not publishing is what keeps it private (D-081).
METRICS_ADDR=127.0.0.1:9090

# No public signup in the MVP (D-039). The first account is created with:
#   go run ./cmd/konku seed-user -email you@example.com
#
# Setting this to true requires SMTP_URL and MAIL_FROM below, and the process
# refuses to start without them: verification is required before an account is
# usable and the reset link is the only recovery path, so open signup with no
# transport creates accounts that can never be verified or recovered.
ALLOW_SIGNUP=false

# Mail (07 L2). Locally this is the Mailpit catcher from `make mail-up`, which
# accepts everything and delivers nothing — read it at http://localhost:8025.
#
# Production is Resend over SMTP (D-068):
#   SMTP_URL=smtps://resend:re_YOUR_API_KEY@smtp.resend.com:465
# Note smtps, not smtp: implicit TLS on 465. net/smtp refuses to send the API
# key over an unencrypted connection, which is the behaviour you want.
SMTP_URL=smtp://localhost:1025

# The From header.
#
# katzeapps.com is shared across projects and verified once with Resend
# (D-068); projects are separated by the local part, not by subdomain. In
# production this is:
#   MAIL_FROM=Konku <konku@katzeapps.com>
#
# That domain sends transactional mail only. A campaign from any project here
# would degrade the reputation that Konku's verification mail depends on, and
# the symptom is new accounts that look stuck with nothing wrong in the logs.
MAIL_FROM=Konku <konku@katzeapps.local>

# The origin that verification and reset links are built against. NOT cosmetic:
# a wrong value sends every user to a host that cannot verify them, and the
# mail is already delivered by the time anyone notices.
#
# Production: PUBLIC_BASE_URL=https://konkuapp.katzeapps.com
# Locally this is Vite, because that is the one you actually open.
PUBLIC_BASE_URL=http://localhost:5173

# Per-account quotas (07 L8). Not monetisation: an unbounded free write path on
# a shared VPS is an outage waiting for one bad actor, and the pool is capped at
# 10 for the sake of every other project on the box (D-028).
#
# Defaults shown. A limit a real person trips has made the product worse, so
# these are far past any plausible personal knowledge base — they are there to
# stop a script. Anything unset, unparseable or non-positive falls back to the
# default, so a typo cannot refuse every write.
#
# Body size is bounded in code and is not configurable: 1 MiB per request,
# 256 KiB of markdown per note, 200 characters of title.
MAX_NOTES=5000
MAX_CARDS=20000
MAX_WRITES_PER_MINUTE=300

# Login attempts allowed per IP per five minutes. Unlike the three above this
# is not per account — there is no account yet when it applies — so everyone
# behind one NAT shares it. Raise it only if you know the deployment sits
# behind a shared address; the end-to-end suite sets it high because it signs
# a fresh account in for every test from one address.
MAX_LOGIN_ATTEMPTS=10

# Where `make db-dump` writes. Must be outside the repo and outside the Docker
# volume — db-dump refuses anything under the working tree.
#
# Local-only on purpose for now: this protects against `docker compose down -v`
# and a bad migration, which are the likely accidents, but not against losing
# the machine. Point it at a synced folder if you want that today; otherwise it
# is covered when restic lands for the VPS (04-ship).
KONKU_BACKUP_DIR=${HOME}/Backups/konku
