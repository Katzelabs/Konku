# Copy to .env for local development.

# Dev compose exposes Postgres on 5433 to avoid colliding with a local install.
DATABASE_URL=postgres://konku:konku@localhost:5433/konku?sslmode=disable

PORT=8080

# Relaxes cookie Secure so http://localhost works. Never set in production.
DEV=true

# Required outside dev. Generate with: openssl rand -base64 32
SESSION_SECRET=

SESSION_TTL_DAYS=30

# /metrics, on its own listener. Loopback on purpose — a separate socket cannot
# be exposed by a Caddy misconfiguration the way a route on the main mux can.
# Empty disables it. Never bind this to 0.0.0.0 (D-062).
METRICS_ADDR=127.0.0.1:9090

# No public signup in the MVP (D-039). The first account is created with:
#   go run ./cmd/konku seed-user -email you@example.com
ALLOW_SIGNUP=false

# Where `make db-dump` writes. Must be outside the repo and outside the Docker
# volume — db-dump refuses anything under the working tree.
#
# Local-only on purpose for now: this protects against `docker compose down -v`
# and a bad migration, which are the likely accidents, but not against losing
# the machine. Point it at a synced folder if you want that today; otherwise it
# is covered when restic lands for the VPS (04-ship).
KONKU_BACKUP_DIR=$HOME/Backups/konku
