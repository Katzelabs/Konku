# Build output
/bin/
# `go build ./cmd/konku` without -o drops the binary here.
/konku
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# Node
node_modules/

# Env
.env
.env.local

# Editors / OS
.DS_Store
.idea/
*.swp

# TS build info
web/*.tsbuildinfo

# Playwright
web/test-results/
web/playwright-report/
# The dev-proxy suite writes its own, so a failure in one cannot clear the
# other's screenshots and traces before CI uploads them.
web/test-results-dev-proxy/
web/playwright-report-dev-proxy/
web/blob-report/
web/.playwright/
